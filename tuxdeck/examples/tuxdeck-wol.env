# TuxDeck host-side sample: /etc/tuxdeck-wol.env
# Used by systemd/tuxdeck-wol.service
#
# Find your interface name and whether WoL is supported:
#   ip -o link show | awk -F': ' '{print $2}'
#   sudo ethtool <iface> | grep -i wake
#
# 'g' = magic packet. Some NICs also accept 'u' (unicast) or 'b' (broadcast).
TUXDECK_WOL_IFACE=eno1
TUXDECK_WOL_MODE=g
